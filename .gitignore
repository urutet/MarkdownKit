# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode: user state and build products
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcresult
